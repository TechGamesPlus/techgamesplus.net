---
import Base from "@layouts/Base.astro";
import Kickoff from "@components/Kickoff.astro";
import TextImageSection from "@components/TextImageSection.astro";
import Section from "@components/Section.astro"
import NavCard from "@components/NavCard.astro";
import Button from "@components/Button.astro"

import kickoffPhoto from "@images/kickoff-feb26.jpg"
import referenceSheet from "@images/fursona/Sockune - Reference (Artist's BG).png"
import sioteruBustShot from "@images/fursona/Sioteru - Tailias Bust.png"
---

<Base title="Tailias (Fursona)" description="A post about my change from TGP to Tailias">
    <Kickoff contentAlign="left" backgroundImage={kickoffPhoto} backgroundAlt="">
        <h1>Tailias</h1>
        <p>
            This page is dedicated to the showcasing of my fursona, Tailias :3
        </p>
    </Kickoff>
    <NavCard imageSide="right" imageSrc={referenceSheet} imageAlt="A reference sheet of Tailias">
        <h2>
            Reference Sheet
        </h2>
        <Button href="https://linktr.ee/sockune" target="_blank">
            Courtesy of Michaela (@Sockune)
        </Button>
    </NavCard>
    <NavCard imageSide="left" imageSrc={sioteruBustShot} imageAlt="A photo of an angry blue bear.">
        <h2>
            Bust Shot (PFP)
        </h2>
        <Button href="https://www.sioteru.com/" target="_blank">
            Courtesy of Sioteru
        </Button>
    </NavCard>
</Base>
<style>
    h3 {
        text-decoration: underline;
    }
</style>