---
import { Image } from "astro:assets";
import Base from "@layouts/Base.astro";
import Kickoff from "@components/Kickoff.astro";
import NavCard from "@components/NavCard.astro";
import Button from "@components/Button.astro";
import Section from "@components/Section.astro";

import kickoff_image from "@images/kickoff-20260728.png"
import projectsImage from "@images/projects/tgpWebsite.jpg"
import logoImage from "@images/Tee Tee (Glow).png"
import geroPhoto from "@images/cgg/geraldton_feature.jpg"
---

<Base title="Homepage" description="The homepage for my website :)">
	<Kickoff
		contentAlign="left"
		backgroundImage={kickoff_image}
		backgroundAlt="A photo of a person holding a blue teddy bear"
		mobileBackgroundOffset={-1050}
	>
		<h2 style="text-decoration: underline">Welcome!</h2>
		<h3 style="text-decoration: none">My name is Tailias :)</h3>
		<p>
			I'm a furry who works in booze, does video editing, and apparently<br/>
			wants to get into politics somehow.<br/>
			<br/>
			Formerly known online as "TechGamesPlus" between 2020 and 2026.
		</p>
		<Image src={logoImage} alt="TGP Logo" width="300" loading="eager"/>
	</Kickoff>

	<Section contentAlign="center">
		<p>
			<a href="/tailias/tgp-to-tailias"><b>July 28th, 2026:</b> The TechGamesPlus branding has been retired in favour of Tailias</a>
		</p>
	</Section>

	<!-- This image needs replacing -->
	<NavCard
		imageSide="right"
		imageSrc={geroPhoto}
		imageAlt="A photo of a Cathedral on a cloudy day."
	>
		<h2>Tailias (Fursona)</h2>
		<p>
			This page provides details about my fluffy side, Tailias :3
		</p>
		<Button href="tailias">View Here</Button>
	</NavCard>

	<NavCard
		imageSide="left"
		imageSrc={geroPhoto}
		imageAlt="A photo of a Cathedral on a cloudy day."
	>
		<h2>City of Greater Geraldton</h2>
		<p>
			These pages follow my political endeavours for the City of Greater Geraldton in Western Australia
		</p>
		<Button href="cgg">View Here</Button>
	</NavCard>

	<NavCard
		imageSide="right"
		imageSrc={projectsImage}
		imageAlt="A photo of a computer screen featuring a bunch of code"
	>
		<h2>Hobbies & Projects</h2>
		<p>
			These pages list off a bunch of side things that I do in my spare time
		</p>
		<Button href="/projects">View Here</Button>
	</NavCard>
</Base>